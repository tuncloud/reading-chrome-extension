# One image, every binary. The k8s manifest picks one via `command`.
# The builder runs natively on the build host and cross-compiles for the target (arm64 here).
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26 AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH
RUN go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server \
 && go build -trimpath -ldflags="-s -w" -o /out/poller ./cmd/poller

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/server /out/poller /
# Numeric UID/GID (distroless "nonroot"), so Kubernetes can verify runAsNonRoot.
USER 65532:65532
ENTRYPOINT ["/server"]
