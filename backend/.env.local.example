# Copy via `make .env.local` (generates the two secrets), then fill in Notion values.
APP_ENV=local
TABLE_NAME=reading-local
QUEUE_URL=local
NOTION_CLIENT_ID=replace-me
NOTION_CLIENT_SECRET=replace-me
NOTION_VERSION=2025-09-03
TOKEN_ENC_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
DEVICE_TOKEN_PEPPER=REPLACE_WITH_BASE64_32_BYTES
ALLOWED_EXTENSION_IDS=replace-with-unpacked-extension-id
PUBLIC_BASE_URL=
# Keep LOCAL_QUEUE_DELAY_SECONDS >= DEBOUNCE_BUCKET_SECONDS (C5: D >= B).
DEBOUNCE_BUCKET_SECONDS=5
LOCAL_QUEUE_DELAY_SECONDS=5
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# --- Postgres mode (make run-pg) --- uncomment to use; make run-pg sets STORE/DATABASE_URL itself
#STORE=postgres
#DATABASE_URL=postgres://reading:reading@localhost:5432/reading?sslmode=disable
#QUEUE_DELAY_SECONDS=5
